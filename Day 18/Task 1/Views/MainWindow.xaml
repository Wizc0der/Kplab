<Window x:Class="Task_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Task_1"
        Title="Система бронирования отеля" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <!-- Ресурсы и стили -->
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:StatusColorConverter x:Key="StatusColor"/>

        <!-- Кисти -->
        <SolidColorBrush x:Key="Accent" Color="#4A90E2"/>
        <SolidColorBrush x:Key="AccentDark" Color="#357ABD"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#E9ECEF"/>
        <SolidColorBrush x:Key="TextMain" Color="#212529"/>
        <SolidColorBrush x:Key="TextLight" Color="#6C757D"/>
        <SolidColorBrush x:Key="BgHover" Color="#F1F3F5"/>

        <ResourceDictionary MergedDictionaries>
            <ResourceDictionary Source="Views/Animations.xaml"/>
        </ResourceDictionary>

        <!-- Глобальные стили -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Geneva, Verdana, sans-serif"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer Margin="{TemplateBinding Padding}" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonClick}"/>
                                        </Trigger.EnterActions>
                                    </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="14" 
                                Margin="2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E8F4FD"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="ToolBarTray">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <!-- Горячие клавиши -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding BookCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл" FontSize="13">
                <MenuItem Header="Выход" Click="ExitMenuItem_Click" FontSize="13"/>
            </MenuItem>
            <MenuItem Header="Номера" FontSize="13"/>
            <MenuItem Header="Бронирование" FontSize="13"/>
            <MenuItem Header="Настройки" FontSize="13"/>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBarTray DockPanel.Dock="Top" Height="40" Background="Transparent">
            <ToolBar>
                <Button Content="Забронировать" Command="{Binding BookCommand}" Style="{StaticResource {x:Type Button}}"/>
                <Button Content="Редактировать" Command="{Binding EditCommand}" Style="{StaticResource {x:Type Button}}"/>
                <Button Content="Отменить" Command="{Binding CancelCommand}" Style="{StaticResource {x:Type Button}}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Основной контент -->
        <Grid Margin="20" DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: Список номеров -->
            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="4" Margin="0,0,15,0">
                <ListView ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}">
                    ItemContainerStyle="{StaticResource {x:Type ListViewItem}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RoomCard" 
                    Background="{StaticResource Surface}" 
                    CornerRadius="12" 
                    Padding="14" 
                    Margin="2"
                    BorderThickness="1"
                    BorderBrush="{StaticResource Border}"
                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>

                                <Border.Triggers>
                                    <!-- Анимация при загрузке элемента -->
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource FadeScaleIn}"/>
                                    </EventTrigger>

                                    <!-- Пульсация для забронированных -->
                                    <DataTrigger Binding="{Binding Status}" Value="Booked">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource PulseBorder}"/>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PulseBorder"/>
                                        </DataTrigger.ExitActions>
                                        <Setter Property="Background" Value="#FFF5F5F5"/>
                                    </DataTrigger>
                                </Border.Triggers>

                                <StackPanel>
                                    <TextBlock Text="{Binding Number, StringFormat='{}Комната №{0}'}" 
                               FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding PricePerNight, StringFormat='{}{0:C} / ночь'}" 
                               FontSize="13" Foreground="{StaticResource TextLight}" Margin="0,2"/>
                                    <Grid Margin="0,6,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                        <TextBlock Text="{Binding Status}" Margin="14,0,0,0" FontSize="12" 
                                   Foreground="{StaticResource TextLight}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Интерактив: эффект при выборе -->
                            <DataTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RoomCard" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                 To="1.02" Duration="0:0:0.15" AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="RoomCard" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                 To="1.02" Duration="0:0:0.15" AutoReverse="True"/>
                                                <ColorAnimation Storyboard.TargetName="RoomCard" 
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" 
                                                To="#4A90E2" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Правая часть: Форма -->
            <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="14" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Форма бронирования -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Бронирование" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBox Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Margin="0,0,0,8"
                     Tag="ФИО Гостя"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding CheckIn}" Margin="0,0,4,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding CheckOut}" Margin="4,0,0,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Забронировать" Command="{Binding BookCommand}" 
                        Width="120" Margin="0,0,8,0" IsEnabled="{Binding CanBook}"/>
                            <Button Content="Редактировать" Command="{Binding EditCommand}" 
                        Width="100" Margin="0,0,8,0" IsEnabled="{Binding CanEdit}"/>
                            <Button Content="Отменить" Command="{Binding CancelCommand}" 
                        Width="90" IsEnabled="{Binding CanCancel}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- DataGrid с бронями (CRUD отображение) -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Активные брони" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="🗑️" Command="{Binding DeleteBookingCommand}" 
                        Width="28" Height="28" Margin="12,0,0,0" Padding="0" FontSize="12"
                        ToolTip="Удалить выбранную бронь"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Bookings}" 
                      SelectedItem="{Binding SelectedBooking}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Гость" Binding="{Binding GuestName}" Width="*"/>
                                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckIn, StringFormat='{}{0:dd.MM}'}" Width="80"/>
                                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOut, StringFormat='{}{0:dd.MM}'}" Width="80"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E8F4FD"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F7FA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>

                    <!-- Индикатор загрузки (перекрывает всё) -->
                    <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" 
              Background="#B3FFFFFF" Panel.ZIndex="100">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Stroke="{StaticResource Accent}" StrokeThickness="3" 
                         StrokeDashArray="20 10">
                                <Ellipse.RenderTransform>
                                    <RotateTransform CenterX="20" CenterY="20"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)" 
                                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="Обработка..." Margin="0,12,0,0" FontSize="13" 
                           Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar DockPanel.Dock="Bottom" Background="Transparent" BorderThickness="0" Padding="12,4" Margin="20,0,20,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextLight}"/>
        </StatusBar>
    </DockPanel>
</Window>